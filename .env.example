#
# Server Configuration
#
# MCP HTTP bind address (health + HTTP evaluation endpoints + MCP Streamable HTTP)
# MCP_HTTP_BIND=127.0.0.1:8140
# MCP_HTTP_ENDPOINT=/mcp

#
# Ollama Configuration
#
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_RERANK_MODEL=dengcao/Qwen3-Reranker-4B:Q5_K_M

# Alternatives:
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# OLLAMA_EMBEDDING_MODEL=all-minilm

#
# Optional performance tuning (safe defaults)
#
# RAG_EMBEDDING_TIMEOUT_SECS=1200
# RAG_EMBEDDING_CACHE_SIZE=1000
# RAG_RERANKER_TIMEOUT_SECS=60
# RAG_RERANKER_CONCURRENCY=1
# RAG_DEFAULT_LOGPROB=-10.0
